# ============================================================
# BOBO KIDS STUDIO — Environment Secrets Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.template .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to Git (it is in .gitignore)
#   4. NEVER put passwords here — use OAuth2 for YouTube
# ============================================================

# ── Gemini API (Script & Metadata generation) ────────────────
# Get this from: https://aistudio.google.com/app/apikey
# Free tier: no credit card needed
GEMINI_API_KEY=your_gemini_api_key_here

# ── YouTube Data API v3 (OAuth2) ─────────────────────────────
# These are FILE PATHS, not the secrets themselves.
# The actual client_secret.json is downloaded from Google Cloud Console.
# It is also in .gitignore so it will never be committed.
YOUTUBE_CLIENT_SECRET_PATH=client_secret.json
YOUTUBE_TOKEN_PATH=token.pickle

# ── Channel Settings (not secrets, but convenient here) ──────
CHANNEL_NAME=BOBO KIDS STUDIO
TARGET_AGE_MIN=3
TARGET_AGE_MAX=5
DEFAULT_VIDEO_LENGTH_MIN=5
DEFAULT_VIDEO_LENGTH_MAX=7
DEFAULT_SHORTS_COUNT=2
